# ============================================================
#  Nacer_22 — Key Server
#  انسخ هذا الملف إلى .env  ثم عدّل القيم
#  ⚠️ لا ترفع .env إلى GitHub أبداً
# ============================================================

# ---- إلزامي ----
# كلمة مرور لوحة التحكم (16 حرفاً أو أكثر)
ADMIN_PASSWORD=ضع_كلمة_مرور_قوية_هنا

# مفتاح توقيع توكنات المدير (32 بايت hex على الأقل)
ADMIN_JWT_SECRET=ضع_64_حرف_hex_هنا

# مفتاح توقيع توكنات المستخدمين (يجب أن يختلف عن مفتاح المدير)
USER_JWT_SECRET=ضع_64_حرف_hex_آخر_هنا

# ---- اختياري ----
PORT=3000
DB_PATH=keys.db
SUB_LINK=https://t.me/HAX_NON_ROOT

# إجبار التوقيع التشفيري للجهاز (ECDSA). اتركه false ليعمل أي كود من اللوحة
# على أي نسخة من التطبيق. true = يرفض الطلبات غير الموقّعة (signature_required).
REQUIRE_SIGNATURE=false

# مدة صلاحية التوكنات
ADMIN_TOKEN_TTL=1h
USER_TOKEN_TTL=12h

# قائمة أصول مسموحة للـ CORS (فارغة = مفتوح للجميع)
# ALLOWED_ORIGINS=https://key-system-yn0o.onrender.com

# عدد الوكلاء (proxies) أمام السيرفر — Render يحتاج 1
TRUST_PROXY=1
